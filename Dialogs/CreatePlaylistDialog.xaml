<Window x:Class="QAMP.Dialogs.CreatePlaylistDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QAMP.Dialogs"
        Background="Transparent"
        AllowsTransparency="True"
        WindowStyle="None"
        Width="450"
        Height="550"
        Title="{DynamicResource LngCreatePlaylist}"
        WindowStartupLocation="CenterOwner">
        <Border
                Background="{StaticResource SecondaryBackgroundBrush}"
                CornerRadius="{DynamicResource AppCornerRadius}"
                BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1">
                <Grid Margin="20">

                        <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="*"/>
                                <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <TextBlock x:Name="NewPlaylist"
                                   Text="{DynamicResource LngNewPlaylist}"
                                   Foreground="{StaticResource TextBrush}"
                                   FontSize="20"
                                   FontWeight="Bold"
                                   HorizontalAlignment="Center"
                                   Margin="0,0,0,20"/>

                        <Button Grid.Row="1"
                                Width="180"
                                Height="180"
                                Click="SelectCoverButton_Click"
                                Background="{StaticResource CentralPanelCardBackground}">
                                <Grid>
                                        <Image x:Name="CoverImage"
                                               Stretch="UniformToFill"/>
                                        <StackPanel VerticalAlignment="Center"
                                                    x:Name="PlaceholderText">
                                                <TextBlock Text="➕"
                                                           FontSize="30"
                                                           HorizontalAlignment="Center"/>
                                                <TextBlock x:Name="SelectCover"
                                                           Text="{DynamicResource LngSelectCover}"
                                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                                           FontSize="12"
                                                           HorizontalAlignment="Center"/>
                                        </StackPanel>
                                </Grid>
                        </Button>

                        <StackPanel Grid.Row="2"
                                    Margin="0,20">
                                <TextBlock x:Name="TitlePlaylist"
                                           Text="{DynamicResource LngTitlePlaylist}"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="PlaylistNameTextBox"
                                         Background="{StaticResource CentralPanelCardBackground}"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderThickness="0"
                                         Padding="10"
                                         Margin="0,0,0,15"/>

                                <TextBlock x:Name="DescriptionPlaylist"
                                           Text="{DynamicResource LngDescriptionPlaylist}"
                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                           Margin="0,0,0,5"/>
                                <TextBox x:Name="PlaylistDescriptionTextBox"
                                         Background="{StaticResource CentralPanelCardBackground}"
                                         Foreground="{StaticResource TextBrush}"
                                         BorderThickness="0"
                                         Padding="10"
                                         Height="80"
                                         TextWrapping="Wrap"
                                         AcceptsReturn="True"/>
                        </StackPanel>

                        <StackPanel Grid.Row="3"
                                    Orientation="Horizontal"
                                    HorizontalAlignment="Right">
                                <Button x:Name="CancelPlaylist"
                                        Content="{DynamicResource LngCancelPlaylist}"
                                        Click="CancelButton_Click"
                                        Width="100"
                                        Height="35"
                                        Style="{StaticResource ModernPlayerButton}"
                                        Margin="0,0,10,0"
                                        IsCancel="True"
                                        BorderThickness="0">

                                </Button>
                                <Button x:Name="CreatePlaylist"
                                        Content="{DynamicResource LngCreate}"
                                        Click="CreateButton_Click"
                                        Width="100"
                                        Height="35"
                                        Style="{StaticResource ModernPlayerButton}">

                                </Button>
                        </StackPanel>
                </Grid>
        </Border>
</Window>