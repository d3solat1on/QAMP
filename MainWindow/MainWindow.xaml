<Window x:Class="QAMP.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:QAMP"
        xmlns:converters="clr-namespace:QAMP.Converters"
        xmlns:viewModels="clr-namespace:QAMP.ViewModels"
        xmlns:services="clr-namespace:QAMP.Services"
        xmlns:models="clr-namespace:QAMP.Models"
        xmlns:vis="clr-namespace:QAMP.Visualization"
        xmlns:dialogs="clr-namespace:QAMP.Dialogs"
        xmlns:system="clr-namespace:System;assembly=mscorlib"
        mc:Ignorable="d"
        Title="QAMP"
        WindowState="Maximized"
        WindowStartupLocation="CenterScreen"
        FontFamily="GOST type A"
        Loaded="MainWindow_Loaded"
        Background="{StaticResource BackgroundBrush}"
        Foreground="{StaticResource ForegroundBrush}">

        <WindowChrome.WindowChrome>
                <WindowChrome CaptionHeight="30"
                              GlassFrameThickness="0"
                              CornerRadius="{DynamicResource AppCornerRadius}"/>
        </WindowChrome.WindowChrome>

        <Window.Resources>
                <converters:ByteArrayToImageConverter x:Key="ByteArrayToImageConverter"/>
                <converters:LargeTrackImageConverter x:Key="LargeTrackImageConverter"/>
                <converters:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVisConverter"/>
                <BooleanToVisibilityConverter x:Key="BoolToVisConverter"/>
                <converters:PlaylistNameLocalizationConverter x:Key="PlaylistNameLocalizationConverter"/>
                <converters:PlaylistDescriptionLocalizationConverter x:Key="PlaylistDescriptionLocalizationConverter"/>
                <converters:BackgroundBrushConverter x:Key="BackgroundBrushConverter"/>
                <converters:ImageLoadConverter x:Key="ImageLoadConverter"/>
                <converters:BindingProxy x:Key="Proxy"
                                         Data="{Binding Source={x:Static models:SettingsManager.Instance}, Path=Config}"/>
                <ObjectDataProvider x:Key="HeartProvider"
                                    ObjectType="{x:Type converters:FavoriteIconGenerate}"
                                    MethodName="GetHeartGeometry"/>
        </Window.Resources>

        <Grid>
                <Grid.RowDefinitions>
                        <RowDefinition Height="30"/>
                        <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0"
                      Background="{StaticResource SecondaryBackgroundBrush}">
                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Center"
                                    Margin="10,0,0,0"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <TextBlock Text="QAMP"
                                           Foreground="{StaticResource ForegroundBrush}"
                                           FontWeight="Bold"/>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <TextBox x:Name="SearchBox"
                                         Width="300"
                                         Height="30"
                                         Padding="8,4"
                                         Background="{StaticResource TertiaryBackgroundBrush}"
                                         Foreground="{StaticResource ForegroundBrush}"
                                         BorderBrush="{StaticResource BorderBrush}"
                                         BorderThickness="1"
                                         VerticalContentAlignment="Center"
                                         Text=""
                                         KeyDown="SearchBox_KeyDown"/>
                                <Button x:Name="SearchButton"
                                        Style="{StaticResource IconButton}"
                                        Width="30"
                                        Height="30"
                                        Margin="5,0,0,0"
                                        BorderThickness="1"
                                        Click="SearchButton_Click">
                                        <Path Data="{StaticResource searchGeometry}"
                                              Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform"
                                              Width="25"
                                              Height="25"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="ClearSearchButton"
                                        Style="{StaticResource IconButton}"
                                        Width="30"
                                        Height="30"
                                        Margin="5,0,0,0"
                                        BorderThickness="1"
                                        Click="ClearSearchButton_Click">
                                        <Path Data="{StaticResource closeGeometry}"
                                              Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform"
                                              Width="25"
                                              Height="25"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Button>
                        </StackPanel>

                        <StackPanel Orientation="Horizontal"
                                    HorizontalAlignment="Right"
                                    WindowChrome.IsHitTestVisibleInChrome="True">
                                <Button x:Name="EqualizerButton"
                                        Style="{StaticResource IconButton}"
                                        ToolTip="{DynamicResource LngEqualizer}"
                                        Click="EqualizerButton_Click">
                                        <Path Data="{StaticResource EqualizerGeometry}"
                                              Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="Settings"
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        ToolTip="{DynamicResource LngSettings}"
                                        Click="Settings_Click">
                                        <Path Data="{StaticResource settingsGeometry}"
                                              Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnMinimize"
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Click="Minimize_Click">
                                        <Path Data="{StaticResource minimazeGeometry}"
                                              Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Button>

                                <Button x:Name="BtnMaximize"
                                        Style="{StaticResource TitleBarButtonStyle}"
                                        Click="Maximize_Click">
                                        <Path Data="{StaticResource maximizeGeometry}"
                                              Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Button>
                                <Button x:Name="BtnClose"
                                        Style="{StaticResource CloseButtonStyle}"
                                        Click="Close_Click">
                                        <Path Data="{StaticResource closeGeometry}"
                                              Fill="{DynamicResource AccentBrush}"
                                              Stretch="Uniform"
                                              Width="18"
                                              Height="18"
                                              HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>
                                </Button>
                        </StackPanel>
                </Grid>
                <DockPanel Grid.Row="1"
                           LastChildFill="True">
                        <Border DockPanel.Dock="Bottom"
                                ClipToBounds="False"
                                Height="100"
                                Background="{StaticResource SecondaryBackgroundBrush}"
                                BorderBrush="{StaticResource BorderBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="15,0">
                                <Grid>
                                        <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto"/>
                                                <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                        <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="1*"/>
                                                <ColumnDefinition Width="2*"/>
                                                <ColumnDefinition Width="1*"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="0"
                                                    Orientation="Horizontal"
                                                    VerticalAlignment="Center">

                                                <Grid x:Name="FavoriteButton1Grid"
                                                      Height="40">
                                                        <Button x:Name="FavoriteButton"
                                                                Style="{StaticResource IconButton}"
                                                                Click="FavoriteButton_Click"
                                                                Width="40"
                                                                Height="40"
                                                                Margin="0,0,10,0">
                                                                <Path x:Name="FavoriteIcon"
                                                                      Width="25"
                                                                      Height="25"
                                                                      Data="{StaticResource favoriteGeometry}"
                                                                      Fill="{DynamicResource AccentBrush}"
                                                                      Stretch="Uniform"
                                                                      HorizontalAlignment="Center"
                                                                      VerticalAlignment="Center"/>
                                                        </Button>
                                                </Grid>

                                                <StackPanel>
                                                        <TextBlock x:Name="CurrentTrackTitleLeftBottomPanel"
                                                                   Text=""
                                                                   Foreground="{StaticResource ForegroundBrush}"
                                                                   FontSize="14"
                                                                   FontWeight="Bold"/>
                                                        <TextBlock x:Name="CurrentTrackArtistLeftBottomPanel"
                                                                   Text=""
                                                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                                                   FontSize="12"/>
                                                </StackPanel>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="1"
                                                    Margin="0,5"
                                                    VerticalAlignment="Center">

                                                <Grid HorizontalAlignment="Stretch"
                                                      VerticalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel Grid.Column="0"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Right">
                                                                <Grid Height="40">
                                                                        <Button x:Name="FullSpectrumWindowButton"
                                                                                Style="{StaticResource IconButton}"
                                                                                Click="FullSpectrumWindowButton_Click"
                                                                                Width="40"
                                                                                Height="40"
                                                                                Margin="5,0"
                                                                                ToolTip="{DynamicResource LngFullSpectrumWindow}">
                                                                                <Path x:Name="FullSpectrumWindowImage"
                                                                                      Width="25"
                                                                                      Height="25"
                                                                                      Margin="5"
                                                                                      Data="{StaticResource FullSpectrumWindowGeometry}"
                                                                                      Fill="{DynamicResource AccentBrush}"
                                                                                      Stretch="Uniform"/>
                                                                        </Button>
                                                                </Grid>
                                                                <Grid Height="40">
                                                                        <Button x:Name="Shuffle_button"
                                                                                Style="{StaticResource IconButton}"
                                                                                Click="ShuffleButton_Click"
                                                                                Width="40"
                                                                                Height="40"
                                                                                Margin="5,0"
                                                                                ToolTip="{DynamicResource LngShuffle}">
                                                                                <Path x:Name="ShuffleImage"
                                                                                      Width="25"
                                                                                      Height="25"
                                                                                      Margin="5"
                                                                                      Data="{StaticResource shuffleGeometry}"
                                                                                      Fill="{DynamicResource AccentBrush}"
                                                                                      Stretch="Uniform"/>
                                                                        </Button>
                                                                </Grid>
                                                                <Grid Height="40">
                                                                        <Button x:Name="PrevButton"
                                                                                Style="{StaticResource IconButton}"
                                                                                Width="40"
                                                                                Height="40"
                                                                                Margin="5,0"
                                                                                ToolTip="{DynamicResource LngPrev}"
                                                                                Click="PrevButton_Click">
                                                                                <Path Width="25"
                                                                                      Height="25"
                                                                                      Margin="5"
                                                                                      Data="{StaticResource fast_rewindGeometry}"
                                                                                      Fill="{DynamicResource AccentBrush}"
                                                                                      Stretch="Uniform"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                        </Button>
                                                                </Grid>
                                                        </StackPanel>

                                                        <Grid Grid.Column="1"
                                                              HorizontalAlignment="Center">
                                                                <Grid Height="40">
                                                                        <Button x:Name="PlayPauseButton"
                                                                                Style="{StaticResource IconButton}"
                                                                                Width="40"
                                                                                Height="40"
                                                                                Margin="5,0"
                                                                                Click="PlayPauseButton_Click"
                                                                                ToolTip="{DynamicResource LngPlayPause}">
                                                                                <Path x:Name="PlayPauseIcon"
                                                                                      Width="25"
                                                                                      Height="25"
                                                                                      Margin="5"
                                                                                      Data="{StaticResource playGeometry}"
                                                                                      Fill="{DynamicResource AccentBrush}"
                                                                                      Stretch="Uniform"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                        </Button>
                                                                </Grid>
                                                        </Grid>

                                                        <StackPanel Grid.Column="2"
                                                                    Orientation="Horizontal"
                                                                    HorizontalAlignment="Left">
                                                                <Grid Height="40">
                                                                        <Button x:Name="NextButton"
                                                                                Style="{StaticResource IconButton}"
                                                                                Width="40"
                                                                                Height="40"
                                                                                Margin="5,0"
                                                                                Click="NextButton_Click"
                                                                                ToolTip="{DynamicResource LngNext}">
                                                                                <Path Width="25"
                                                                                      Height="25"
                                                                                      Margin="5"
                                                                                      Data="{StaticResource fast_forwardGeometry}"
                                                                                      Fill="{DynamicResource AccentBrush}"
                                                                                      Stretch="Uniform"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                        </Button>
                                                                </Grid>
                                                                <Grid Height="40">
                                                                        <Button x:Name="RepeatButton"
                                                                                Style="{StaticResource IconButton}"
                                                                                Click="RepeatButton_Click"
                                                                                Width="40"
                                                                                Height="40"
                                                                                Margin="5,0"
                                                                                ToolTip="{DynamicResource LngRepeat}">
                                                                                <Path x:Name="RepeatIcon"
                                                                                      Width="25"
                                                                                      Height="25"
                                                                                      Margin="5"
                                                                                      Data="{StaticResource repeatGeometry}"
                                                                                      Fill="{DynamicResource AccentBrush}"
                                                                                      Stretch="Uniform"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                        </Button>
                                                                </Grid>
                                                                <Grid Height="40">
                                                                        <Button x:Name="ViewLyrics"
                                                                                Style="{StaticResource IconButton}"
                                                                                Click="ViewLyricsButton_Click"
                                                                                Width="40"
                                                                                Height="40"
                                                                                Margin="5,0"
                                                                                ToolTip="{DynamicResource LngViewLyrics}">
                                                                                <Path Width="25"
                                                                                      Height="25"
                                                                                      Margin="5"
                                                                                      Data="{StaticResource lyricsGeometry}"
                                                                                      Fill="{DynamicResource AccentBrush}"
                                                                                      Stretch="Uniform"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                        </Button>
                                                                </Grid>
                                                        </StackPanel>
                                                </Grid>

                                                <Grid Margin="20,5"
                                                      HorizontalAlignment="Stretch">
                                                        <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto"/>
                                                                <ColumnDefinition Width="*"/>
                                                                <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <TextBlock x:Name="CurrentTimeText"
                                                                   Grid.Column="0"
                                                                   Text="0:00"
                                                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                                                   FontSize="12"
                                                                   FontFamily="Segoe UI"
                                                                   VerticalAlignment="Center"
                                                                   Margin="0,0,10,0"
                                                                   MinWidth="35"
                                                                   TextAlignment="Right"/>

                                                        <Slider x:Name="ProgressSlider"
                                                                Grid.Column="1"
                                                                Style="{StaticResource ModernSliderStyle}"
                                                                Minimum="0"
                                                                Maximum="100"
                                                                Thumb.DragStarted="ProgressSlider_DragStarted"
                                                                Thumb.DragCompleted="ProgressSlider_DragCompleted"
                                                                PreviewMouseLeftButtonDown="Slider_PreviewMouseLeftButtonDown"
                                                                VerticalAlignment="Center"
                                                                Margin="0,5"/>

                                                        <TextBlock x:Name="TotalTimeText"
                                                                   Grid.Column="2"
                                                                   Text="0:00"
                                                                   Foreground="{StaticResource SecondaryForegroundBrush}"
                                                                   FontSize="12"
                                                                   FontFamily="Segoe UI"
                                                                   VerticalAlignment="Center"
                                                                   Margin="10,0,0,0"
                                                                   MinWidth="35"/>
                                                </Grid>
                                        </StackPanel>

                                        <StackPanel Grid.Row="0"
                                                    Grid.Column="2"
                                                    Orientation="Horizontal"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Center"
                                                    ClipToBounds="False"
                                                    Margin="0,0,15,0">

                                                <Button x:Name="VolumeButton"
                                                        Style="{StaticResource VolumeButtonStyle}"
                                                        MouseDoubleClick="VolumeButton_MouseDoubleClick"
                                                        Width="32"
                                                        Height="32"
                                                        Padding="0">
                                                        <Path x:Name="VolumeImage"
                                                              Width="18"
                                                              Height="18"
                                                              Data="{StaticResource volumeGeometry}"
                                                              Fill="{DynamicResource AccentBrush}"
                                                              Stretch="Uniform"
                                                              HorizontalAlignment="Center"
                                                              VerticalAlignment="Center"/>
                                                </Button>

                                                <Slider x:Name="VolumeSlider"
                                                        Style="{StaticResource ModernSliderStyle}"
                                                        ValueChanged="VolumeSlider_ValueChanged"
                                                        VerticalAlignment="Center"
                                                        Width="100"
                                                        Minimum="0"
                                                        Maximum="100"
                                                        Margin="5,0,5,0"/>

                                                <TextBlock x:Name="VolumePercentage"
                                                           Foreground="{StaticResource SecondaryForegroundBrush}"
                                                           FontSize="11"
                                                           FontFamily="Segoe UI"
                                                           Width="35"
                                                           TextAlignment="Right"/>
                                        </StackPanel>
                                </Grid>
                        </Border>

                        <Grid>

                                <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="300"/>
                                </Grid.ColumnDefinitions>

                                <Image Source="{Binding Source={x:Static models:SettingsManager.Instance}, Path=Config.CustomBackgroundPath, Converter={StaticResource ImageLoadConverter}}"
                                       Grid.Column="0"
                                       Grid.ColumnSpan="3"
                                       Stretch="UniformToFill"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Visibility="{Binding Source={x:Static models:SettingsManager.Instance}, Path=Config.UseCustomBackground, Converter={StaticResource BoolToVisConverter}}">
                                        <Image.Effect>
                                                <BlurEffect Radius="3"
                                                            KernelType="Box"/>
                                        </Image.Effect>
                                </Image>
                                <!-- Playlists -->
                                <Border x:Name="LeftZona"
                                        Width="250"
                                        Grid.Column="0"
                                        BorderBrush="{StaticResource BorderBrush}"
                                        BorderThickness="0,0,1,0"
                                        Margin="0,0,0,0"
                                        Background="{Binding Source={x:Static models:SettingsManager.Instance}, Path=Config.CustomBackgroundPath, Converter={StaticResource BackgroundBrushConverter}}">
                                        <Grid Margin="10">
                                                <Grid.RowDefinitions>
                                                        <RowDefinition Height="Auto"/>
                                                        <RowDefinition Height="*"/>
                                                </Grid.RowDefinitions>
                                                <Grid Grid.Row="0"
                                                      Margin="10,0,10,15">
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="Auto"/>
                                                        </Grid.RowDefinitions>

                                                        <TextBlock Grid.Row="0"
                                                                   x:Name="LibraryTextBlock"
                                                                   Text="LIBRARY"
                                                                   FontSize="28"
                                                                   FontWeight="Bold"
                                                                   Foreground="{StaticResource ForegroundBrush}"
                                                                   HorizontalAlignment="Center"
                                                                   Margin="0,0,0,12"/>

                                                        <UniformGrid Grid.Row="1"
                                                                     Columns="4"
                                                                     Height="40">

                                                                <Button x:Name="SortByButton"
                                                                        Style="{StaticResource IconButton}"
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        Click="SortByButton_Click"
                                                                        ToolTip="{DynamicResource LngSortByButton}">
                                                                        <Path Data="{StaticResource sortGeometry}"
                                                                              Fill="{DynamicResource AccentBrush}"
                                                                              Stretch="Uniform"
                                                                              Width="40"
                                                                              Height="40"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                </Button>

                                                                <Button x:Name="CreatePlaylistButton"
                                                                        Style="{StaticResource IconButton}"
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        Click="CreatePlaylistButton_Click"
                                                                        ToolTip="{DynamicResource LngCreatePlaylist}">
                                                                        <Path Data="{StaticResource create_playlistGeometry}"
                                                                              Fill="{DynamicResource AccentBrush}"
                                                                              Stretch="Uniform"
                                                                              Width="40"
                                                                              Height="40"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                </Button>

                                                                <Button x:Name="RemovePlaylistButton"
                                                                        Style="{StaticResource IconButton}"
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        Click="RemovePlaylist_Click"
                                                                        ToolTip="{DynamicResource LngRemovePlaylist}">
                                                                        <Path Data="{StaticResource playlist_removeGeometry}"
                                                                              Fill="{DynamicResource AccentBrush}"
                                                                              Stretch="Uniform"
                                                                              Width="40"
                                                                              Height="40"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                </Button>

                                                                <Button x:Name="AddMusicButton"
                                                                        Style="{StaticResource IconButton}"
                                                                        Background="Transparent"
                                                                        BorderBrush="Transparent"
                                                                        Click="AddMusicButton_Click"
                                                                        ToolTip="{DynamicResource LngAddMusic}">
                                                                        <Button.Resources>
                                                                                <Style TargetType="ContextMenu"
                                                                                       x:Key="ModernMenu">
                                                                                        <Setter Property="Background"
                                                                                                Value="{DynamicResource SecondaryBackgroundBrush}"/>
                                                                                        <Setter Property="BorderBrush"
                                                                                                Value="{DynamicResource AccentBrush}"/>
                                                                                        <Setter Property="Template">
                                                                                                <Setter.Value>
                                                                                                        <ControlTemplate TargetType="ContextMenu">
                                                                                                                <Border Background="{TemplateBinding Background}"
                                                                                                                        BorderBrush="{TemplateBinding BorderBrush}"
                                                                                                                        BorderThickness="1"
                                                                                                                        CornerRadius="{DynamicResource AppCornerRadius}">
                                                                                                                        <StackPanel IsItemsHost="True"
                                                                                                                                    Margin="5"/>
                                                                                                                </Border>
                                                                                                        </ControlTemplate>
                                                                                                </Setter.Value>
                                                                                        </Setter>
                                                                                </Style>
                                                                        </Button.Resources>

                                                                        <Button.ContextMenu>
                                                                                <ContextMenu x:Name="AddMusicMenu"
                                                                                             Style="{StaticResource ModernMenu}">
                                                                                        <MenuItem x:Name="MenuAddFilesPlaylist"
                                                                                                  Header="{DynamicResource LngAddFiles}"
                                                                                                  Click="AddFilesToPlaylist_Click"/>
                                                                                        <MenuItem x:Name="MenuAddFolderPlaylist"
                                                                                                  Header="{DynamicResource LngAddFolder}"
                                                                                                  Click="AddFolderToPlaylist_Click"/>
                                                                                </ContextMenu>
                                                                        </Button.ContextMenu>

                                                                        <Path Data="{StaticResource add_musicGeometry}"
                                                                              Fill="{DynamicResource AccentBrush}"
                                                                              Stretch="Uniform"
                                                                              Width="40"
                                                                              Height="40"
                                                                              HorizontalAlignment="Center"
                                                                              VerticalAlignment="Center"/>
                                                                </Button>

                                                        </UniformGrid>
                                                </Grid>

                                                <Grid Grid.Row="1"
                                                      x:Name="PlaylistsLoadingPlaceholder"
                                                      Visibility="Collapsed">
                                                        <StackPanel VerticalAlignment="Top"
                                                                    Margin="8">
                                                                <Border Height="45"
                                                                        Margin="0,5"
                                                                        CornerRadius="{DynamicResource AppCornerRadius}"
                                                                        Background="#333333"
                                                                        Opacity="0.5"/>
                                                                <Border Height="45"
                                                                        Margin="0,5"
                                                                        CornerRadius="{DynamicResource AppCornerRadius}"
                                                                        Background="#333333"
                                                                        Opacity="0.5"/>
                                                                <Border Height="45"
                                                                        Margin="0,5"
                                                                        CornerRadius="{DynamicResource AppCornerRadius}"
                                                                        Background="#333333"
                                                                        Opacity="0.5"/>
                                                                <Border Height="45"
                                                                        Margin="0,5"
                                                                        CornerRadius="{DynamicResource AppCornerRadius}"
                                                                        Background="#333333"
                                                                        Opacity="0.5"/>
                                                                <Border Height="45"
                                                                        Margin="0,5"
                                                                        CornerRadius="{DynamicResource AppCornerRadius}"
                                                                        Background="#333333"
                                                                        Opacity="0.5"/>
                                                        </StackPanel>
                                                </Grid>

                                                <ListBox Grid.Row="1"
                                                         x:Name="PlaylistsListBox"
                                                         Background="Transparent"
                                                         BorderThickness="0"
                                                         Foreground="{StaticResource ForegroundBrush}"
                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                         SelectionChanged="PlaylistsListBox_SelectionChanged"
                                                         Height="Auto"
                                                         AllowDrop="True"
                                                         ItemsSource="{Binding Playlists, Source={x:Static local:ViewModels.MusicLibrary.Instance}}">
                                                        <ListBox.ItemContainerStyle>
                                                                <Style TargetType="ListBoxItem">
                                                                        <EventSetter Event="PreviewMouseMove"
                                                                                     Handler="Playlist_MouseMove"/>
                                                                        <EventSetter Event="Drop"
                                                                                     Handler="Playlist_Drop"/>
                                                                        <Setter Property="Background"
                                                                                Value="Transparent"/>
                                                                        <Setter Property="BorderThickness"
                                                                                Value="0"/>
                                                                </Style>
                                                        </ListBox.ItemContainerStyle>
                                                        <ListBox.ItemTemplate>
                                                                <DataTemplate>
                                                                        <Border x:Name="PlaylistItemBorder"
                                                                                BorderBrush="#333333"
                                                                                BorderThickness="0,0,0,1"
                                                                                Padding="8"
                                                                                Margin="0,2"
                                                                                Background="Transparent">
                                                                                <Grid>
                                                                                        <Grid.ColumnDefinitions>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="Auto"/>
                                                                                                <ColumnDefinition Width="*"/>
                                                                                        </Grid.ColumnDefinitions>

                                                                                        <Border x:Name="PlaylistCoverBorder"
                                                                                                Grid.Column="0"
                                                                                                Width="45"
                                                                                                Height="45"
                                                                                                BorderBrush="{StaticResource BorderBrush}"
                                                                                                BorderThickness="1"
                                                                                                CornerRadius="{DynamicResource AppCornerRadius}"
                                                                                                Background="{StaticResource CentralPanelCardBackground}">
                                                                                                <Grid>
                                                                                                        <Image Source="{Binding CoverImage, Converter={StaticResource ByteArrayToImageConverter}}"
                                                                                                               Stretch="UniformToFill"
                                                                                                               RenderOptions.BitmapScalingMode="LowQuality"
                                                                                                               Margin="2">
                                                                                                                <Image.Style>
                                                                                                                        <Style TargetType="Image">
                                                                                                                                <Setter Property="Visibility"
                                                                                                                                        Value="Visible"/>
                                                                                                                                <Style.Triggers>
                                                                                                                                        <DataTrigger Binding="{Binding CoverImage}"
                                                                                                                                                     Value="{x:Null}">
                                                                                                                                                <Setter Property="Visibility"
                                                                                                                                                        Value="Collapsed"/>
                                                                                                                                        </DataTrigger>
                                                                                                                                        <DataTrigger Binding="{Binding CoverImage.Length}"
                                                                                                                                                     Value="0">
