                                                                                                                        </Style>
                                                                                                                </Image.Style>
                                                                                                        </Image>
                                                                                                </Grid>
                                                                                        </Border>
                                                                                </DataTemplate>
                                                                        </DataGridTemplateColumn.CellTemplate>

                                                                </DataGridTemplateColumn>
                                                                <DataGridTextColumn Header="TITLE"
                                                                                    Binding="{Binding Name}"
                                                                                    Width="3*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="TextBlock">
                                                                                        <Setter Property="TextBlock.Foreground"
                                                                                                Value="{StaticResource DataGridCellForeground}"/>
                                                                                        <Setter Property="TextBlock.Margin"
                                                                                                Value="10,0,0,0"/>
                                                                                        <Setter Property="TextBlock.VerticalAlignment"
                                                                                                Value="Center"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <DataGridTextColumn Header="ARTIST"
                                                                                    Binding="{Binding Executor}"
                                                                                    Width="2*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="TextBlock">
                                                                                        <Setter Property="TextBlock.Foreground"
                                                                                                Value="{StaticResource CentralPanelSecondaryForeground}"/>
                                                                                        <Setter Property="TextBlock.Margin"
                                                                                                Value="10,0,0,0"/>
                                                                                        <Setter Property="TextBlock.VerticalAlignment"
                                                                                                Value="Center"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <DataGridTextColumn Header="ALBUM"
                                                                                    Binding="{Binding Album}"
                                                                                    Width="2*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="TextBlock">
                                                                                        <Setter Property="TextBlock.Foreground"
                                                                                                Value="{StaticResource CentralPanelSecondaryForeground}"/>
                                                                                        <Setter Property="TextBlock.Margin"
                                                                                                Value="10,0,0,0"/>
                                                                                        <Setter Property="TextBlock.VerticalAlignment"
                                                                                                Value="Center"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <DataGridTextColumn Header="DURATION"
                                                                                    Binding="{Binding Duration}"
                                                                                    Width="1*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="TextBlock">
                                                                                        <Setter Property="TextBlock.Foreground"
                                                                                                Value="{StaticResource CentralPanelSecondaryForeground}"/>
                                                                                        <Setter Property="TextBlock.Margin"
                                                                                                Value="10,0,0,0"/>
                                                                                        <Setter Property="TextBlock.VerticalAlignment"
                                                                                                Value="Center"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>

                                                                <DataGridTextColumn Header="BITRATE"
                                                                                    Binding="{Binding Bitrate}"
                                                                                    Visibility="{Binding Data.IsCompactMode, 
                                                                                        Source={StaticResource Proxy}, 
                                                                                        Converter={StaticResource InverseBoolToVisConverter}}"
                                                                                    Width="1*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="TextBlock">
                                                                                        <Setter Property="TextBlock.Foreground"
                                                                                                Value="{StaticResource CentralPanelSecondaryForeground}"/>
                                                                                        <Setter Property="TextBlock.Margin"
                                                                                                Value="10,0,0,0"/>
                                                                                        <Setter Property="TextBlock.VerticalAlignment"
                                                                                                Value="Center"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTextColumn Header="GENRE"
                                                                                    Binding="{Binding Genre}"
                                                                                    Visibility="{Binding Data.IsCompactMode, 
                                                                                                Source={StaticResource Proxy}, 
                                                                                                Converter={StaticResource InverseBoolToVisConverter}}"
                                                                                    Width="1*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="TextBlock">
                                                                                        <Setter Property="TextBlock.Foreground"
                                                                                                Value="{StaticResource CentralPanelSecondaryForeground}"/>
                                                                                        <Setter Property="TextBlock.Margin"
                                                                                                Value="10,0,0,0"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                                <DataGridTextColumn Header="DATE ADDED"
                                                                                    Binding="{Binding AddedDate, StringFormat=\{0:dd.MM.yyyy HH:mm\}}"
                                                                                    Visibility="{Binding Data.IsCompactMode, Source={StaticResource Proxy}, Converter={StaticResource InverseBoolToVisConverter}}"
                                                                                    Width="1*">
                                                                        <DataGridTextColumn.ElementStyle>
                                                                                <Style TargetType="TextBlock">
                                                                                        <Setter Property="TextBlock.Foreground"
                                                                                                Value="{StaticResource CentralPanelSecondaryForeground}"/>
                                                                                        <Setter Property="TextBlock.Margin"
                                                                                                Value="10,0,0,0"/>
                                                                                </Style>
                                                                        </DataGridTextColumn.ElementStyle>
                                                                </DataGridTextColumn>
                                                        </DataGrid.Columns>
                                                </DataGrid>
                                                <Grid x:Name="LyricsOverlay"
                                                      Visibility="Collapsed"
                                                      Background="{Binding Source={x:Static models:SettingsManager.Instance}, Path=Config.CustomBackgroundPath, Converter={StaticResource BackgroundBrushConverter}}">

                                                        <ListBox x:Name="LyricsListBox"
                                                                 Margin="50,20"
                                                                 Background="Transparent"
                                                                 BorderThickness="0"
                                                                 VerticalAlignment="Stretch"
                                                                 HorizontalContentAlignment="Center"
                                                                 ScrollViewer.VerticalScrollBarVisibility="Hidden"
                                                                 VirtualizingStackPanel.IsVirtualizing="False"
                                                                 PreviewKeyDown="LyricsListBox_PreviewKeyDown"
                                                                 MouseWheel="LyricsListBox_MouseWheel">

                                                                <ListBox.ItemContainerStyle>
                                                                        <Style TargetType="ListBoxItem">
                                                                                <Setter Property="Template">
                                                                                        <Setter.Value>
                                                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                                                        <ContentPresenter/>
                                                                                                </ControlTemplate>
                                                                                        </Setter.Value>
                                                                                </Setter>
                                                                                <Setter Property="Cursor"
                                                                                        Value="Hand"/>
                                                                                <EventSetter Event="PreviewMouseLeftButtonDown"
                                                                                             Handler="LrcLine_Click"/>
                                                                        </Style>
                                                                </ListBox.ItemContainerStyle>

                                                                <ListBox.ItemTemplate>
                                                                        <DataTemplate>
                                                                                <TextBlock Text="{Binding Text}"
                                                                                           FontSize="32"
                                                                                           TextAlignment="Center"
                                                                                           Margin="0,15"
                                                                                           TextWrapping="Wrap">
                                                                                        <TextBlock.Style>
                                                                                                <Style TargetType="TextBlock">
                                                                                                        <Setter Property="Foreground"
                                                                                                                Value="{StaticResource ForegroundBrush}"/>
                                                                                                        <Setter Property="Opacity"
                                                                                                                Value="0.6"/>
                                                                                                        <Style.Triggers>
                                                                                                                <DataTrigger Binding="{Binding IsActive}"
                                                                                                                             Value="True">
                                                                                                                        <Setter Property="Foreground"
                                                                                                                                Value="{StaticResource TextBrush}"/>
                                                                                                                        <Setter Property="Opacity"
                                                                                                                                Value="1.0"/>
                                                                                                                        <Setter Property="FontWeight"
                                                                                                                                Value="Bold"/>
                                                                                                                </DataTrigger>
                                                                                                        </Style.Triggers>
                                                                                                </Style>
                                                                                        </TextBlock.Style>
                                                                                </TextBlock>
                                                                        </DataTemplate>
                                                                </ListBox.ItemTemplate>
                                                        </ListBox>
                                                </Grid>
                                        </Grid>
                                </Grid>

                                <!-- NowPlaying -->
                                <Border x:Name="RightPanelBorder"
                                        Grid.Column="2"
                                        Width="300"
                                        HorizontalAlignment="Stretch"
                                        Background="{Binding Source={x:Static models:SettingsManager.Instance}, Path=Config.CustomBackgroundPath, Converter={StaticResource BackgroundBrushConverter}}"
                                        BorderThickness="1,0,0,0"
                                        BorderBrush="{StaticResource BorderBrush}">
                                        <Grid>
                                                <Grid>
                                                        <Grid.RowDefinitions>
                                                                <RowDefinition Height="Auto"/>
                                                                <RowDefinition Height="*"/>
                                                        </Grid.RowDefinitions>

                                                        <Grid x:Name="NowPlayingLoadingPlaceholder"
                                                              Visibility="Collapsed"
                                                              Margin="20">
                                                                <StackPanel VerticalAlignment="Top">
                                                                        <Border Height="275"
                                                                                Width="275"
                                                                                CornerRadius="{DynamicResource AppCornerRadius}"
                                                                                Background="#333333"
                                                                                Opacity="0.5"
                                                                                Margin="0,15"
                                                                                HorizontalAlignment="Center"/>
                                                                        <Border Height="30"
                                                                                CornerRadius="{DynamicResource AppCornerRadius}"
                                                                                Background="#333333"
                                                                                Opacity="0.5"
                                                                                Margin="0,15"/>
                                                                        <Border Height="25"
                                                                                CornerRadius="{DynamicResource AppCornerRadius}"
                                                                                Background="#333333"
                                                                                Opacity="0.5"
                                                                                Margin="0,15"/>
                                                                        <Border Height="20"
                                                                                CornerRadius="{DynamicResource AppCornerRadius}"
                                                                                Background="#333333"
                                                                                Opacity="0.5"
                                                                                Margin="0,15"/>
                                                                </StackPanel>
                                                        </Grid>

                                                        <StackPanel Grid.Row="0"
                                                                    VerticalAlignment="Top"
                                                                    Margin="0,0,15,0"
                                                                    x:Name="NowPlayingPanel">
                                                                <TextBlock x:Name="NowPlaying"
                                                                           Text=""
                                                                           Foreground="{StaticResource ForegroundBrush}"
                                                                           FontSize="20"
                                                                           FontWeight="Bold"
                                                                           Margin="0,0,0,20"/>
                                                                <Border x:Name="CurrentTrackImage1"
                                                                        HorizontalAlignment="Center"
                                                                        VerticalAlignment="Center"
                                                                        CornerRadius="{DynamicResource AppCornerRadius}"
                                                                        ClipToBounds="True"
                                                                        Height="300"
                                                                        Width="300"
                                                                        Background="{StaticResource CentralPanelCardBackground}"
                                                                        BorderBrush="{StaticResource CentralPanelCardBorderBrush}"
                                                                        BorderThickness="1">
                                                                        <Grid>
                                                                                <Path x:Name="DefaultCoverPath"
                                                                                      Data="{StaticResource default_coverGeometry}"
                                                                                      Fill="{DynamicResource AccentBrush}"
                                                                                      Stretch="Uniform"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"
                                                                                      Width="275"
                                                                                      Height="275"
                                                                                      Visibility="Visible"/>
                                                                                <Image x:Name="CurrentTrackImage"
                                                                                       HorizontalAlignment="Stretch"
                                                                                       VerticalAlignment="Stretch"
                                                                                       UseLayoutRounding="True"
                                                                                       RenderOptions.BitmapScalingMode="HighQuality"
                                                                                       Visibility="Collapsed"/>
                                                                        </Grid>
                                                                </Border>
                                                                <TextBlock x:Name="CurrentTrackName"
                                                                           Text=""
                                                                           FontSize="22"
                                                                           FontWeight="Bold"
                                                                           Foreground="{StaticResource CentralPanelHighlightForeground}"
                                                                           TextWrapping="Wrap"
                                                                           Margin="0,5,0,0"/>
                                                                <TextBlock x:Name="CurrentTrackExecutor"
                                                                           Text=""
                                                                           FontSize="20"
                                                                           Foreground="{StaticResource CentralPanelSecondaryForeground}"
                                                                           Margin="0,5"/>
                                                                <TextBlock x:Name="CurrentTrackAlbum"
                                                                           Text=""
                                                                           FontSize="20"
                                                                           Foreground="{StaticResource CentralPanelSecondaryForeground}"/>
                                                                <TextBlock x:Name="CurrentTrackData"
                                                                           Text=""
                                                                           FontSize="16"
                                                                           Foreground="{StaticResource CentralPanelMutedForeground}"
                                                                           Margin="0,20,0,0"/>
                                                                <TextBlock x:Name="CurrentTrackExtension"
                                                                           Text=""
                                                                           FontSize="16"
                                                                           Foreground="{StaticResource CentralPanelMutedForeground}"/>
                                                                <TextBlock x:Name="CurrentTrackYear"
                                                                           Text=""
                                                                           FontSize="16"
                                                                           Foreground="{StaticResource CentralPanelMutedForeground}"/>
                                                                <StackPanel x:Name="NextTrackPanel"
                                                                            Margin="0,20,0,0">
                                                                        <TextBlock x:Name="NextTrack"
                                                                                   Text=""
                                                                                   FontSize="12"
                                                                                   Foreground="{StaticResource CentralPanelSecondaryForeground}"
                                                                                   FontWeight="Bold"/>
                                                                        <TextBlock x:Name="NextTrackName"
                                                                                   Text=""
                                                                                   FontSize="14"
                                                                                   Foreground="{StaticResource ForegroundBrush}"
                                                                                   TextWrapping="Wrap"/>
                                                                </StackPanel>
                                                                <Grid>
                                                                        <vis:SpectrumControl x:Name="SpectrumViewer"
                                                                                             Height="150"
                                                                                             VerticalAlignment="Bottom"
                                                                                             HorizontalAlignment="Stretch"
                                                                                             BorderThickness="2"/>
                                                                </Grid>
                                                        </StackPanel>

                                                        <StackPanel Grid.Row="1"
                                                                    x:Name="StackPanelBottomQueue"
                                                                    HorizontalAlignment="Right"
                                                                    VerticalAlignment="Bottom">
                                                                <Grid Height="40">
                                                                        <Button x:Name="OpenQueue"
                                                                                Style="{StaticResource IconButton}"
                                                                                Click="OpenQueue_Click"
                                                                                Width="40"
                                                                                Height="40"
                                                                                Margin="5,0"
                                                                                ToolTip="{DynamicResource LngQueueMusic}">
                                                                                <Path Width="25"
                                                                                      Height="25"
                                                                                      Margin="5"
                                                                                      Data="{StaticResource QueueMusicGeometry}"
                                                                                      Fill="{DynamicResource AccentBrush}"
                                                                                      Stretch="Uniform"
                                                                                      HorizontalAlignment="Center"
                                                                                      VerticalAlignment="Center"/>
                                                                        </Button>
                                                                </Grid>
                                                        </StackPanel>
                                                </Grid>

                                                <Border x:Name="QueuePanel"
                                                        Width="150"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Stretch"
                                                        Visibility="Collapsed"
                                                        Background="{Binding Source={x:Static models:SettingsManager.Instance}, Path=Config.CustomBackgroundPath, Converter={StaticResource BackgroundBrushConverter}}"
                                                        BorderThickness="1,0,0,0"
                                                        BorderBrush="{StaticResource BorderBrush}">
                                                        <!-- Margin="10,10,5,50" grid grid grid grid grid grid  -->
                                                        <Grid>
                                                                <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/>
                                                                        <RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>

                                                                <TextBlock Grid.Row="0"
                                                                           Text="{DynamicResource LngQueueMusic}"
                                                                           Foreground="{StaticResource ForegroundBrush}"
                                                                           FontSize="16"
                                                                           FontWeight="Bold"
                                                                           Margin="0,0,0,10"/>

                                                                <ListBox Grid.Row="1"
                                                                         x:Name="QueueListBox"
                                                                         Background="Transparent"
                                                                         BorderThickness="0"
                                                                         AllowDrop="True"
                                                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                                         ScrollViewer.VerticalScrollBarVisibility="Auto"
                                                                         PreviewMouseLeftButtonDown="QueueListBox_PreviewMouseLeftButtonDown"
                                                                         MouseMove="QueueListBox_MouseMove"
                                                                         DragOver="QueueListBox_DragOver"
                                                                         Drop="QueueListBox_Drop">

                                                                        <ListBox.ContextMenu>
                                                                                <ContextMenu>
                                                                                        <MenuItem Header="{DynamicResource LngPlayFromQueue}"
                                                                                                Click="PlayFromQueue_Click"/>
                                                                                        <MenuItem Header="{DynamicResource LngRemoveFromQueue}"
                                                                                                  Click="RemoveFromQueue_Click"/>
                                                                                </ContextMenu>
                                                                        </ListBox.ContextMenu>

                                                                        <ListBox.ItemTemplate>
                                                                                <DataTemplate>
                                                                                        <StackPanel Margin="0,5"
                                                                                                    Width="130"
                                                                                                    Background="Transparent">
                                                                                                <TextBlock Text="{Binding Name}"
                                                                                                           Foreground="{StaticResource CentralPanelHighlightForeground}"
                                                                                                           FontSize="13"
                                                                                                           FontWeight="SemiBold"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                                <TextBlock Text="{Binding Executor}"
                                                                                                           Foreground="{StaticResource CentralPanelSecondaryForeground}"
                                                                                                           FontSize="11"
                                                                                                           Margin="0,2,0,0"
                                                                                                           TextTrimming="CharacterEllipsis"/>
                                                                                        </StackPanel>
                                                                                </DataTemplate>
                                                                        </ListBox.ItemTemplate>
                                                                </ListBox>
                                                        </Grid>
                                                </Border>

                                        </Grid>
                                </Border>
                        </Grid>
                </DockPanel>
                <dialogs:ModernNotice x:Name="MyToast"
                                      Grid.Row="1"
                                      VerticalAlignment="Bottom"
                                      HorizontalAlignment="Center"
                                      Panel.ZIndex="9999"/>
        </Grid>
</Window>