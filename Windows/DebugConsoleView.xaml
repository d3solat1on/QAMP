<UserControl x:Class="QAMP.Windows.DebugConsoleView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="{DynamicResource BackgroundBrush}"
             Height="200">
    <Grid Margin="5">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <TextBox Grid.Row="0"
                 x:Name="ConsoleOutputBox"
                 Background="Transparent"
                 Foreground="{DynamicResource ForegroundBrush}"
                 FontFamily="Consolas"
                 FontSize="12"
                 IsReadOnly="True"
                 AcceptsReturn="True"
                 VerticalScrollBarVisibility="Auto"
                 BorderThickness="0"/>
        <Grid Grid.Row="1">
            <Popup x:Name="SuggestionsPopup"
                   PlacementTarget="{Binding ElementName=CommandInputBox}"
                   Placement="Top"
                   IsOpen="False"
                   StaysOpen="True"
                   AllowsTransparency="True">
                <Border Background="{DynamicResource SecondaryBackgroundBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        MaxHeight="120"
                        Width="{Binding ActualWidth, ElementName=CommandInputBox}">
                    <ListBox x:Name="SuggestionsListBox"
                             Background="Transparent"
                             Foreground="{DynamicResource ForegroundBrush}"
                             BorderThickness="0"
                             FontFamily="Consolas"
                             FontSize="12"
                             MouseLeftButtonUp="SuggestionsListBox_MouseLeftButtonUp"
                             PreviewKeyDown="SuggestionsListBox_PreviewKeyDown"/>
                </Border>
            </Popup>
            <TextBox x:Name="ConsoleInputBox"
                     Background="{DynamicResource SecondaryBackgroundBrush}"
                     Foreground="{DynamicResource TextBrush}"
                     FontFamily="Consolas"
                     FontSize="14"
                     VerticalScrollBarVisibility="Auto"
                     BorderThickness="0"
                     Height="30"
                     Visibility="Visible"
                     TextChanged="ConsoleInputBox_TextChanged"
                     PreviewKeyDown="ConsoleInputBox_PreviewKeyDown"/>
        </Grid>
    </Grid>
</UserControl>